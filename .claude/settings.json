{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run format:check)",
      "Bash(npm run format)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm audit)",
      "Bash(npm audit *)",
      "Bash(npm outdated)",
      "Bash(npm ls *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(review *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin master)",
      "Bash(git push origin HEAD:master)",
      "Bash(npm audit fix --force *)",
      "Bash(npm audit fix --force)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
